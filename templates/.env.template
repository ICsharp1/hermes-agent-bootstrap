# Environment secrets template
# Place these in ~/.hermes/.env

# Groq API key for high-speed voice transcription (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Timezone override for daily plan checkers (defaults to system / Asia/Jerusalem)
# HERMES_TIMEZONE=America/New_York

# Optional: Marker string to identify personal events on shared/group calendars
# HERMES_CALENDAR_USER_MARKER=
